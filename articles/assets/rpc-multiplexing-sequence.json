      "to": "Server",
      "y": 580,
      "label": "req=100 后完成"
    },
    {
      "id": "responseStream",
      "from": "Server",
      "to": "Channel",
      "y": 620,
      "label": "响应流：300 | 100"
    },
    {
      "id": "match",
      "from": "Channel",
      "to": "Caller",
      "y": 660,
